# OwnCoffer — server settings. Copy to docker/.env (never commit it), or run
# ./docker/generate-env.sh which fills the secrets with random values.

# Single public port (app + API). Decision 0015. Must be free on the host
# (check with: ss -ltn).
OWNCOFFER_PORT=8080
# 127.0.0.1: only the local Cloudflare connector can reach it (recommended).
# 0.0.0.0: reachable from the network (only if Cloudflare connects directly).
OWNCOFFER_BIND=127.0.0.1
# Address users type in their browser (used in emails and links).
OWNCOFFER_PUBLIC_URL=https://owncoffer.example.org
# Real client IP (decision 0015). CF-Connecting-IP is only trusted from
# Cloudflare and from these addresses (the local Cloudflare connector, seen
# through the Docker gateway). If OWNCOFFER_BIND=0.0.0.0, remove the private
# ranges your local network uses, or anyone on it could fake their IP.
OWNCOFFER_TRUSTED_LOCAL=127.0.0.0/8 ::1/128 172.16.0.0/12

# Automatic IP ban: MAX_FAILURES failed logins / codes within WINDOW minutes
# ban the IP for BAN minutes, doubled at each new ban.
OWNCOFFER_BAN_MAX_FAILURES=5
OWNCOFFER_BAN_WINDOW_MINUTES=15
OWNCOFFER_BAN_MINUTES=60
# Never banned (e.g. your home network), space-separated CIDR ranges.
OWNCOFFER_IP_ALLOWLIST=
# Requests per minute and per IP on the API.
OWNCOFFER_RATE_LIMIT_PER_MINUTE=600

# Outgoing email (verification codes, password reset, invitations).
# Left empty: emails are written to the server log instead
# (docker compose -f docker/compose.yaml logs owncoffer).
OWNCOFFER_SMTP_HOST=
OWNCOFFER_SMTP_PORT=587
# starttls (587), ssl (465) or none (local relay only)
OWNCOFFER_SMTP_SECURITY=starttls
OWNCOFFER_SMTP_USER=
OWNCOFFER_SMTP_PASSWORD=
OWNCOFFER_SMTP_FROM=owncoffer@example.org

# Image: change only if you build and publish your own.
OWNCOFFER_IMAGE=ghcr.io/cmathias27/owncoffer
# Image tag: a published version (see CHANGELOG.md), or edge (latest main).
OWNCOFFER_TAG=0.3.17

# Secrets — long random values, different on every server.
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=
OWNCOFFER_SERVICE_SECRET=
OWNCOFFER_EMAIL_PEPPER=
OWNCOFFER_JWT_KEY=
OWNCOFFER_JWT_REFRESH_PEPPER=
