# Single public port (decision 0015): /api/… → Serverpod API, the rest → web app.
{
	admin off
	auto_https off
	servers {
		# Real client IP (decisions 0012 and 0015, issue #18): CF-Connecting-IP
		# is only read when the request comes from the local Cloudflare
		# connector (OWNCOFFER_TRUSTED_LOCAL, through the Docker gateway) or
		# from Cloudflare itself (ranges from https://www.cloudflare.com/ips/).
		# Anyone else gets their TCP address, whatever headers they send.
		trusted_proxies static {$OWNCOFFER_TRUSTED_LOCAL:127.0.0.0/8 ::1/128 172.16.0.0/12} 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	handle_path /api/* {
		# Financial data is never cached, neither by the browser nor by any
		# intermediate proxy (decision 0011).
		header Cache-Control "no-store"
		header Pragma "no-cache"
		reverse_proxy owncoffer:8080 {
			# Overwrites any value sent by the client.
			header_up X-OwnCoffer-Client-IP {client_ip}
		}
	}

	handle {
		reverse_proxy owncoffer:8082 {
			header_up X-OwnCoffer-Client-IP {client_ip}
		}
	}
}
